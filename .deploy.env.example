# Copy to .deploy.env (git-ignored) and adjust. deploy.sh sources it. Nothing secret belongs here:
# keys are read from FILES you point at, and are stored only in cluster Secrets.

# Hostnames become crew.<BASE_DOMAIN> and auth.<BASE_DOMAIN>. nip.io maps <ip>.nip.io to <ip>.
export BASE_DOMAIN=203.0.113.10.nip.io

# --- Inference: use any one (or several) ---
# OpenRouter (hard credit limit is set on the key at OpenRouter; the soft cap below stops dispatch earlier)
# export OPENROUTER_API_KEY_FILE=$HOME/openrouter.key
# export OPENROUTER_BUDGET_USD=5
# export AGENT_OPS_MODEL=openrouter/openai/gpt-5.6-luna
# export AGENT_DEVELOPER_MODEL=openrouter/openai/gpt-5.6-luna
# export AGENT_REVIEWER_MODEL=openrouter/google/gemini-2.5-flash
# export AGENT_INSIGHT_MODEL=openrouter/openai/gpt-5.6-luna
# export OPTCHAT_MODEL=openrouter/openai/gpt-4.1-nano
# Any OpenAI-compatible endpoint (vLLM, Ollama, LiteLLM, a gateway). Add LOCAL_LLM_VISION=true if it accepts images.
# export LOCAL_LLM_BASE_URL=http://llm.internal:8000/v1
# export LOCAL_LLM_MODEL=my-model
# export LOCAL_LLM_API_KEY_FILE=$HOME/llm.key
# Direct OpenAI: OPENAI_API_KEY=sk-... ./deploy.sh
# With none of these the agents run on scripted offline demo brains.

# --- Demo tuning ---
# export COMPACT_KEEP_RECENT_TOKENS=1500   # compaction keeps this much recent context (default 20000)
# export OPTCHAT_VIEW_BYTES=2500           # size of the compressed memory view (default 6000)
